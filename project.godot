; Engine configuration file.
; ECHO//SHIFT - Godot 4 3D action-adventure

config_version=5

[application]

config/name="ECHO//SHIFT"
config/description="3D sci-fi action-adventure built around the Echo record-and-replay mechanic."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=0
config/icon="res://icon.svg"

[autoload]

Cfg="*res://autoload/cfg.gd"
Bus="*res://autoload/bus.gd"
Prefs="*res://autoload/prefs.gd"
GameState="*res://autoload/game_state.gd"
SaveSys="*res://autoload/save_sys.gd"
Sfx="*res://autoload/sfx.gd"
Net="*res://autoload/net.gd"

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/integer_division=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="echo"
3d_physics/layer_5="player_projectile"
3d_physics/layer_6="enemy_projectile"
3d_physics/layer_7="trigger"
3d_physics/layer_8="hazard"

[physics]

3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.012, 0.02, 0.035, 1)
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/directional_shadow/size=2048
